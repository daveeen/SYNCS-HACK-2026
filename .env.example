# Copy to .env.local and fill in. .env.local is gitignored — never commit a key.
#
#   cp .env.example .env.local
#
# The app BOOTS AND DEMOS WITHOUT ANY OF THESE, on mock data. You only need the
# Anthropic key once you're implementing /api/report or the enrich pipeline.

# --- Required for real Claude output ----------------------------------------
# Server-side only. Note: NO NEXT_PUBLIC_ prefix. Prefixing it would ship the
# key to the browser (CLAUDE.md rule 4). Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# --- Embeddings -------------------------------------------------------------
# None. Deliberate: embeddings run locally via @xenova/transformers
# (Xenova/all-MiniLM-L6-v2), so there is no second key and no per-query cost.

# --- Required for the forum -------------------------------------------------
# Supabase provides the forum's database and accounts. The Graveyard demo
# (search, report, reconstruct) does not touch it and still runs without these.
#
# Keys are the sb_publishable_ / sb_secret_ format from Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=

# Public by design — it ships to the browser. Row Level Security is what
# protects the data, not secrecy of this key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. BYPASSES Row Level Security completely. Never NEXT_PUBLIC_,
# and never imported outside app/api/*. Treat it like ANTHROPIC_API_KEY.
SUPABASE_SERVICE_ROLE_KEY=
