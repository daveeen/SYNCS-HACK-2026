# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets never get committed, but the template MUST be
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# @xenova/transformers caches ~90MB of model weights here on first run
/.cache
/node_modules/.cache

# Fact-check patches: agent scratch, superseded once apply-audit.ts merges them
data/.audit/

# Site-clone study output: ~91MB, and it contains another person's
# copyrighted assets (photos, resume, case studies). Never commit this.
/output/
/site-clone/
